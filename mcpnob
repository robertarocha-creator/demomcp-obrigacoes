.chat[data-p="gemini"] .cta button { border-color: #1a73e8; color: #1a73e8; }
.chat[data-p="gemini"] .cta button:hover { background: #1a73e8; color: #fff; }
.chat[data-p="gemini"] .ans-card, .chat[data-p="gemini"] .ans-file { border-radius: 18px; }
.chat[data-p="gemini"] .ans-file-go { color: #1a73e8; }

/* Grok: monocromático, seco e direto */
.chat[data-p="grok"] { --ur: 12px; --cr: 18px; --kbg: #ebe9e5; --kfg: #3f3d39; --intfg: #6e6b66; --inticon: grayscale(1) opacity(.7); --chipline: #e2dfda; }
