.cx-url small { color: #6a7b92; font-size: 11.5px; }
.cx-url code { font: 600 16px ui-monospace, 'SF Mono', Menlo, monospace; color: var(--ink); overflow-wrap: anywhere; }
.cx-copy { display: flex; align-items: center; gap: 6px; border: 1px solid var(--line); background: #fff; border-radius: 10px; padding: 8px 12px; font: 500 12.5px 'Poppins', sans-serif; color: var(--petroleo); cursor: pointer; }
.cx-copy.ok { background: #e8f6ec; border-color: #b8e0c4; color: #2e7d4f; }
.cx-steps { list-style: none; counter-reset: s; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
.cx-steps li { counter-increment: s; display: flex; align-items: center; gap: 14px; background: #f5f8fc; border-radius: 12px; padding: 11px 16px; font-size: 14px; line-height: 1.4; }
.cx-steps li::before { content: counter(s); width: 28px; height: 28px; border-radius: 50%; background: var(--cx, var(--azul)); color: #fff; display: grid; place-items: center; font-weight: 600; font-size: 13px; flex: none; }
.cx-plan { margin: 0; color: #5b6b82; font-size: 12.5px; line-height: 1.5; }

@media (max-width: 1100px) {
  /* telas menores: o Nibo aparece acima do chat (transição simples, em linhas) */
  .stage { grid-template-columns: 1fr; grid-template-rows: 0fr 1fr; column-gap: 0; row-gap: 0; transition: grid-template-rows var(--dur) var(--ease), row-gap var(--dur) var(--ease); }
  .stage[data-mode="workspace"] { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; row-gap: 10px; }
  .pane-chat { max-width: none; }
  .nb-view { inset: 0; width: auto; }
}
@media (prefers-reduced-motion: reduce) {
  .spin { animation-duration: 2s; }
}

