.stage[data-mode="workspace"][data-focus="nibo"] .pane-chat, .stage[data-mode="workspace"][data-focus="chat"] .pane-nibo { opacity: .96; }
/* o Nibo tem largura final fixa e fica ancorado à direita do painel: ao crescer, parece deslizar para dentro */
.nb-view { position: absolute; top: 0; bottom: 0; right: 0; width: var(--nbw, 60%); overflow: hidden; background: #fff; }
.nb-canvas { position: absolute; left: 0; top: 0; transform-origin: 0 0; transition: transform .9s cubic-bezier(.4, 0, .2, 1); pointer-events: none; will-change: transform; }
.nb-canvas.no-tr { transition: none; }

/* selo "A IA está ..." sobre o Nibo */
.ai-pill { position: absolute; left: 50%; bottom: 14px; transform: translate(-50%, 10px); opacity: 0; pointer-events: none; display: flex; align-items: center; gap: 9px; background: #fff; border: 1px solid #dbe6f3; border-radius: 999px; padding: 6px 14px 6px 7px; font: 400 12.5px 'Poppins', sans-serif; color: var(--petroleo); box-shadow: 0 4px 16px rgba(0, 45, 114, .14); transition: opacity .3s, transform .3s; white-space: nowrap; z-index: 5; }
.ai-pill.on { opacity: 1; transform: translate(-50%, 0); }
.ai-pill img { width: 22px; height: 22px; object-fit: contain; border-radius: 50%; }
.ai-pill b { font-weight: 600; }

.spin { width: 14px; height: 14px; border: 2px solid #cfe3f5; border-top-color: var(--claro); border-radius: 50%; animation: rot .8s linear infinite; flex: none; display: inline-block; }
@keyframes rot { to { transform: rotate(360deg); } }
@keyframes blink { 50% { opacity: 0; } }
@keyframes pop { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }

/* ---------- modal Como conectar ---------- */
.cx { position: fixed; inset: 0; z-index: 100; display: grid; place-items: center; }
.cx[hidden] { display: none; }
.cx-back { position: absolute; inset: 0; background: rgba(0, 26, 64, .6); animation: fadeIn .2s; }
.cx-card { position: relative; width: min(780px, 94vw); max-height: 92vh; overflow: auto; background: #fff; border-radius: 20px; padding: 22px 30px 28px; animation: pop .25s; }
