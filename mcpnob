      'f-resp': ['Todos', ...names], 'f-status': ['Em aberto', 'A fazer', 'Em andamento', 'Pendente', 'Aguardando cliente', 'Concluído'],
      'f-cliente': ['Todos', ...cl], 'f-dept': ['Todos', ...d.departments],
      'f-d-dept': d.departments, 'f-d-resp': names, 'f-d-clientes': cl.filter((c) => !S.drawerClients.includes(c)),
      'f-e-dept': d.departments, 'f-e-resp': names, 'f-e-cliente': d.clients.map((c) => `${c.code} - ${c.name} (${c.doc})`),
      'p-cliente': ['Todos', ...cl], 'p-obrig': ['Todas', ...d.obligations]
    }[id] || [];
