  /* linha de tarefa, sempre calculada do registro */
  const taskItem = (t) => {
    const late = Q.isLate(t);
    const parts = [late ? `Venceu em ${Q.short(t.due)}, há ${Q.plural(Q.daysLate(t), 'dia', 'dias')}` : `Vence em ${Q.short(t.due)}`, Q.deptShort(t.dept), Q.uname(t.resp)];
    if (t.status === 'Aguardando cliente') parts.push('aguardando cliente');
    return `<li><b>${Q.esc(t.title)}</b><span>${parts.filter(Boolean).join(' · ')}</span></li>`;
  };

  /* ================================================================
     MVP 1 — Consulta: tarefas atrasadas de um cliente
     ================================================================ */
  add({
    id: 'overdue-client', kind: 'Consulta', short: 'Tarefas atrasadas do cliente',
    prompt: 'Quais tarefas estão atrasadas para a Comercial Aurora?',
    keywords: ['atrasada', 'atrasadas', 'atraso', 'tarefa', 'tarefas', 'comercial', 'aurora', 'pendência', 'pendencias'],
    company: 'aur', modules: ['tarefas'], featured: true, done: 'Consulta concluída',
    build(ctx, p) {
