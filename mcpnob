.ubtn:hover, .ubtn[aria-expanded="true"] { background: #e9eef5; color: var(--petroleo); }
.ubtn:focus-visible, .hd-opt:focus-visible, .chip-p:focus-visible, .ptop-btn:focus-visible, .pm-item:focus-visible { outline: 2px solid var(--claro); outline-offset: 1px; }
