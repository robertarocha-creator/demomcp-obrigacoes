.cta button:hover { background: #0072CE; color: #fff; }

/* =====================================================================
   Assinatura de cada IA. A estrutura é única; aqui mudam só cor, raio,
   tipografia e pequenos acentos, sempre sob [data-p].
   ===================================================================== */
.kind { background: var(--kbg, #eef0f3); color: var(--kfg, #4b5563); }
.usedint { color: var(--intfg, var(--muted)); }
.usedint img { filter: var(--inticon, grayscale(1)); }
.usedint .ui-chv { color: var(--intac, currentColor); }
.usedint:hover { color: var(--intfg, var(--fg)); }
.wl-head { display: flex; flex-direction: column; align-items: center; gap: 11px; }
.wl-logo { width: 28px; height: 28px; object-fit: contain; display: block; }
.chat[data-p="grok"] .wl-logo { border-radius: 7px; }
.msgs { gap: 22px; }

/* ChatGPT: neutro, minimalista, sem avatar */
.chat[data-p="chatgpt"] { --kbg: #f1f1f1; --kfg: #5a5a5a; --inticon: grayscale(1) opacity(.65); --chipline: #ececec; --ur: 18px; }
.chat[data-p="chatgpt"] .chip-p { border-radius: 14px; }
