  <script>
/* Consultas sobre a massa fictícia ATUAL (a que está na tela do Nibo).
   As respostas das IAs são montadas com estas funções, então texto e tabela
   nunca divergem, inclusive depois de uma tarefa criada ou de um prazo alterado. */
(function () {
  const ND = window.NiboDemo;
  const D = ND.data;
  const Q = (ND.q = {});

  const state = () => ND.nibo.data();
  const pad = (n) => String(n).padStart(2, '0');
  const WEEK = ['domingo', 'segunda-feira', 'terça-feira', 'quarta-feira', 'quinta-feira', 'sexta-feira', 'sábado'];

  /* ---------- datas ---------- */
  Q.parse = (s) => { const [d, m, y] = s.split('/').map(Number); return new Date(y, m - 1, d); };
  Q.fmt = (dt) => `${pad(dt.getDate())}/${pad(dt.getMonth() + 1)}/${dt.getFullYear()}`;
  Q.today = () => D.get().today;
  Q.addDays = (s, n) => { const d = Q.parse(s); d.setDate(d.getDate() + n); return Q.fmt(d); };
  Q.weekday = (s) => WEEK[Q.parse(s).getDay()];
  Q.daysBetween = (a, b) => Math.round((Q.parse(b) - Q.parse(a)) / 86400000);
  Q.yesterday = () => Q.addDays(Q.today(), -1);
  Q.tomorrow = () => Q.addDays(Q.today(), 1);
  /* próxima ocorrência de um dia da semana (0=domingo ... 6=sábado), sempre à frente de hoje */
  Q.nextWeekday = (dow) => { let d = Q.today(); do { d = Q.addDays(d, 1); } while (Q.parse(d).getDay() !== dow); return d; };
  Q.nextFriday = () => Q.nextWeekday(5);
  Q.nextMonday = () => Q.nextWeekday(1);
  Q.dayLabel = (s) => { const w = Q.weekday(s); return w.charAt(0).toUpperCase() + w.slice(1) + ', ' + s; };
  Q.short = (s) => s.slice(0, 5); // dd/mm

  /* ---------- nomes ---------- */
  Q.client = (id) => D.client(id);
  Q.cname = (id) => (id ? D.client(id).name : '');
  Q.user = (ini) => D.get().users.find((u) => u.ini === ini);
  Q.uname = (ini) => (Q.user(ini) || { name: ini }).name;
  Q.userByName = (name) => D.get().users.find((u) => u.name === name);
  /* artigo da empresa para frases naturais: "da Comercial Aurora", "do Restaurante Mesa Verde" */
  const MASC = { mes: true };
  Q.de = (id) => (MASC[id] ? 'do ' : 'da ') + Q.cname(id);
  Q.para = (id) => (MASC[id] ? 'para o ' : 'para a ') + Q.cname(id);
  Q.art = (id) => (MASC[id] ? 'o' : 'a');
  /* "A <b>Comercial Aurora</b>" para abrir frases */
  Q.TheB = (id) => `${MASC[id] ? 'O' : 'A'} <b>${Q.esc(Q.cname(id))}</b>`;
  Q.deptShort = (d) => d.replace(/^Departamento (de )?/, '');

  /* ---------- tarefas ---------- */
  Q.isOpen = (t) => !['Concluído', 'Cancelado', 'Baixa justificada'].includes(t.status);
  Q.isLate = (t) => Q.isOpen(t) && !!t.due && D.key(t.due) < D.key(Q.today());
  Q.daysLate = (t) => Q.daysBetween(t.due, Q.today());
  Q.task = (id) => state().tasks.find((t) => t.id === id);

  /* filtros: {client, dept, late, resp(iniciais), status, dueBy} -> tarefas abertas, da mais antiga para a mais nova */
  Q.tasks = (f = {}) => state().tasks
    .filter((t) => Q.isOpen(t) &&
      (!f.client || t.client === f.client) &&
      (!f.dept || t.dept === f.dept) &&
      (!f.late || Q.isLate(t)) &&
      (!f.resp || t.resp === f.resp) &&
      (!f.status || t.status === f.status) &&
      (!f.dueOn || t.due === f.dueOn))
    .sort((a, b) => D.key(a.due) - D.key(b.due));

  /* ---------- protocolos ---------- */
  Q.protocols = (f = {}) => state().protocols
    .filter((p) => (!f.client || p.client === f.client) && (!f.obl || p.obl === f.obl) && (!f.near || Q.isNear(p)))
    .sort((a, b) => D.key(a.due) - D.key(b.due));
  /* "próximo do vencimento": de hoje até 7 dias à frente */
  Q.isNear = (p) => { const k = D.key(p.due); return k >= D.key(Q.today()) && k <= D.key(Q.addDays(Q.today(), 7)) && p.status !== 'Pago'; };
  Q.oblShort = (o) => o.replace(/ - .*$/, '').replace(/ Digital$/, '').replace(/ \(.*\)$/, '');

  /* ---------- agrupamentos e texto ---------- */
  /* [{key, n, items}] do maior para o menor; empate pelo nome */
  Q.group = (items, keyFn, nameFn = (k) => k) => {
    const m = new Map();
    items.forEach((i) => { const k = keyFn(i); if (!m.has(k)) m.set(k, []); m.get(k).push(i); });
    return [...m.entries()].map(([key, arr]) => ({ key, n: arr.length, items: arr })).sort((a, b) => b.n - a.n || nameFn(a.key).localeCompare(nameFn(b.key), 'pt-BR'));
  };
  Q.plural = (n, one, many) => `${n} ${n === 1 ? one : many}`;
  Q.join = (arr) => (arr.length < 2 ? arr.join('') : arr.slice(0, -1).join(', ') + ' e ' + arr[arr.length - 1]);
  Q.esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');
  Q.b = (s) => `<b>${Q.esc(s)}</b>`;
})();

