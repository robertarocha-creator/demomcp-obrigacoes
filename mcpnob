  <script>
/* Lado esquerdo: simulação do Nibo Contador (Obrigações / Tarefas & Processos).
   A tela é construída em HTML e reproduz os prints/Figmas fornecidos.
   O "usuário" é a IA: um cursor com o nome dela clica, digita e escolhe opções.
   Os cliques disparam de verdade as ações da tela (data-act), então o que
   aparece é o resultado real da interação, e não uma imagem. */
(function () {
  const ND = window.NiboDemo;
  const I = ND.icon;
  const D = ND.data;
  const N = (ND.nibo = {});
  const W = 1200; // largura "virtual" do Nibo; a tela é reduzida para caber no painel

  let view, canvas, side, top, screenEl, ovEl, menusEl, toastsEl, cur, S;
  const vs = { s0: 1, H: 800 };
  const cam = { z: 1, cx: null, cy: null };

  const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
  const q = (sel) => canvas.querySelector(sel);
  const fld = (id) => canvas.querySelector(`[data-id="${id}"]`);
  const clientName = (id) => (id ? D.client(id).name : '');
  const clientDoc = (id) => (id ? D.client(id).doc : '');

  const TF0 = { q: '', resp: 'Todos', status: 'Em aberto', cliente: 'Todos', dept: 'Todos', ini: '', fim: '' };
  const PF0 = { q: '', cliente: 'Todos', obl: 'Todas', ini: '01/10/2026', fim: '31/10/2026' };

  const CHIP = {
    'Aguardando cliente': 'purple', 'A fazer': 'gray', 'Em andamento': 'cyan', Pendente: 'red',
    Concluído: 'green', Entregue: 'green', 'E-mail aberto': 'cyan', Visualizado: 'green',
    'Enviando e-mail': 'gray', Pago: 'green', 'Aguardando entrega física': 'gray'
  };
  const chip = (s) => `<i class="chip ${CHIP[s] || 'gray'}">${esc(s)}</i>`;

  /* ---------- estado ---------- */
  N.reset = function () {
    S = {
      screen: 'calendario', group: 'obrigacoes', data: D.fresh(), tf: { ...TF0 }, pf: { ...PF0 },
      more: false, drawerClients: [], freshId: null, seq: 0, editId: null
    };
    cam.z = 1; cam.cx = null; cam.cy = null;
    if (canvas) {
      ovEl.innerHTML = ''; menusEl.innerHTML = ''; toastsEl.innerHTML = '';
      hideCursor(true);
      go('calendario');
      applyCam();
    }
  };

  N.data = () => S.data;
  N.lastCreatedId = () => S.freshId;

  N.matches = (c) =>
    Object.entries(c).every(([k, v]) => {
      if (k === 'screen') return S.screen === v;
      if (k === 'group') return S.group === v;
      if (k === 'more') return S.more === v;
      if (k === 'filtered') return (JSON.stringify(S.tf) !== JSON.stringify(TF0)) === v;
      if (k === 'pfiltered') return (JSON.stringify(S.pf) !== JSON.stringify(PF0)) === v;
      return false;
    });

  /* ---------- montagem ---------- */
  N.init = function (viewEl, canvasEl, providerLabel) {
    view = viewEl; canvas = canvasEl;
    canvas.innerHTML = `
      <div class="nb">
        <aside class="nb-rail">
          <img class="rail-logo" src="data:image/png;base64," alt="Nibo">
          <span class="rail-btn on">${I('calendar-check', 20)}</span>
          <span class="rail-btn">${I('chart', 20)}</span>
          <span class="rail-btn">${I('store', 20)}</span>
          <span class="rail-sp"></span>
          <span class="rail-mini">${I('gift', 18)}<small>News</small></span>
          <span class="rail-mini">${I('help', 18)}<small>Ajuda</small></span>
          <span class="rail-av">AL</span>
        </aside>
        <nav class="nb-side"></nav>
        <div class="nb-main"><header class="nb-top"></header><div class="nb-screen"></div></div>
        <div class="nb-ov"></div><div class="nb-menus"></div><div class="nb-toasts"></div>
        <div class="nb-cur"><div class="cur-in"><svg width="22" height="22" viewBox="0 0 24 24"><path d="M4 3l16 7.5-6.6 2L10.5 20z" fill="#41B6E6" stroke="#fff" stroke-width="1.6" stroke-linejoin="round"/></svg><span class="cur-tag"><img alt=""><b></b></span><span class="cur-rip"></span></div></div>
      </div>`;
    side = q('.nb-side'); top = q('.nb-top'); screenEl = q('.nb-screen');
    ovEl = q('.nb-ov'); menusEl = q('.nb-menus'); toastsEl = q('.nb-toasts'); cur = q('.nb-cur');
    canvas.addEventListener('click', (e) => { const t = e.target.closest('[data-act]'); if (t) onAct(t); });
    N.reset();
    layout();
    if ('ResizeObserver' in window) new ResizeObserver(layout).observe(view);
    window.addEventListener('resize', layout);
  };

  N.setProvider = (p) => {
    if (!cur) return;
    cur.querySelector('img').src = p.logo;
    cur.querySelector('b').textContent = p.name;
  };

  /* ---------- câmera ---------- */
  function layout() {
    const vw = view.clientWidth, vh = view.clientHeight;
    if (!vw || !vh) return;
    vs.s0 = vw / W; vs.H = vh / vs.s0;
    canvas.style.width = W + 'px'; canvas.style.height = vs.H + 'px';
    canvas.classList.add('no-tr'); applyCam(); void canvas.offsetWidth; canvas.classList.remove('no-tr');
  }
  function applyCam() {
    const vw = view.clientWidth, vh = view.clientHeight, s = vs.s0 * cam.z;
    const cx = cam.cx == null ? W / 2 : cam.cx, cy = cam.cy == null ? vs.H / 2 : cam.cy;
    const tx = Math.min(0, Math.max(vw - W * s, vw / 2 - cx * s));
    const ty = Math.min(0, Math.max(vh - vs.H * s, vh / 2 - cy * s));
    canvas.style.transform = `translate(${tx}px,${ty}px) scale(${s})`;
    if (cur) cur.style.setProperty('--k', Math.max(1, 0.95 / s).toFixed(3));
  }
  function posIn(el) {
    const cr = canvas.getBoundingClientRect(), sc = cr.width / canvas.offsetWidth, r = el.getBoundingClientRect();
    return { x: (r.left - cr.left) / sc, y: (r.top - cr.top) / sc, w: r.width / sc, h: r.height / sc };
  }
  async function focus(sel, z) {
    const el = q(sel); if (!el) return;
    const p = posIn(el);
    z = Math.min(1.07, 1 + (z - 1) * 0.25); // aproximação discreta (máx. 1,07×; teto aceito 1,10×)
    cam.z = z; cam.cx = p.x + p.w / 2; cam.cy = p.y + p.h / 2;
    applyCam(); await ND.sleep(950);
  }
  async function focusReset() { cam.z = 1; cam.cx = null; cam.cy = null; applyCam(); await ND.sleep(900); }

  /* ---------- cursor da IA ---------- */
  let curShown = false;
  function showCursor() {
    if (curShown) return;
    curShown = true;
    cur.style.transition = 'none';
    cur.style.transform = `translate(${W * 0.72}px,${vs.H * 0.3}px)`;
    void cur.offsetWidth;
    cur.classList.add('on');
  }
  function hideCursor(now) { curShown = false; if (cur) cur.classList.remove('on'); }
  N.hideCursor = hideCursor;

  async function moveTo(el, left) {
    showCursor();
    const p = posIn(el);
    const x = p.x + (left ? Math.min(34, p.w * 0.3) : Math.min(p.w / 2, 70));
    const y = p.y + p.h / 2;
    const m = cur.style.transform.match(/translate\(([-\d.]+)px,\s*([-\d.]+)px\)/);
    const dist = m ? Math.hypot(x - +m[1], y - +m[2]) : 400;
    const sec = 0.35 + Math.min(dist, 1200) / 1500;
    cur.style.transition = `transform ${sec / ND.speed}s cubic-bezier(.45,.05,.2,1), opacity .3s`;
    cur.style.transform = `translate(${x}px,${y}px)`;
    await ND.sleep(sec * 1000 + 40);
  }
  function ripple() {
    const r = cur.querySelector('.cur-rip');
    r.classList.remove('go'); void r.offsetWidth; r.classList.add('go');
  }
  async function click(el, left) {
    if (!el) throw new Error('Elemento não encontrado no Nibo');
    await moveTo(el, left); ripple(); await ND.sleep(140);
    el.click(); await ND.sleep(260);
  }
  async function type(id, text) {
    const f = fld(id); if (!f) throw new Error('Campo não encontrado: ' + id);
    await moveTo(f, true); ripple(); await ND.sleep(160);
    const v = f.querySelector('.v');
    f.classList.add('typing'); v.textContent = '';
    for (const ch of text) { v.textContent += ch; await ND.sleep(52); }
    await ND.sleep(220); f.classList.remove('typing');
  }
  async function pickOption(id, opt) {
    const f = fld(id); if (!f) throw new Error('Campo não encontrado: ' + id);
    await click(f, true); await ND.sleep(280);
    const o = Array.from(menusEl.querySelectorAll('.mi')).find((m) => m.dataset.val === opt);
    if (!o) throw new Error('Opção não encontrada: ' + opt);
    await click(o, true); await ND.sleep(200);
  }
  function highlight(sel) {
    canvas.querySelectorAll('.hl').forEach((e) => e.classList.remove('hl'));
    canvas.querySelectorAll(sel).forEach((e) => e.classList.add('hl'));
  }

  /* Vista de Tarefas: faz só o que falta para chegar ao filtro desejado
     (navega, abre "Mais opções", escolhe cliente/departamento, digita o prazo, filtra). */
  async function tasksView(scope) {
    if (S.screen !== 'tarefas') { await click(q('[data-nav="side-tarefas"]')); await ND.sleep(450); }
    const want = { cliente: scope.client ? clientName(scope.client) : 'Todos', dept: scope.dept || 'Todos', fim: scope.late ? ND.q.yesterday() : '' };
    const cur = S.tf;
    const chg = want.cliente !== cur.cliente || want.dept !== cur.dept || want.fim !== cur.fim;
    if ((want.cliente !== cur.cliente || want.dept !== cur.dept) && !S.more) await click(q('[data-id="more-filters"]'));
    if (want.cliente !== cur.cliente) await pickOption('f-cliente', want.cliente);
    if (want.dept !== cur.dept) await pickOption('f-dept', want.dept);
    if (want.fim !== cur.fim) await type('f-prazo-fim', want.fim);
    if (chg) await click(q('[data-id="btn-filtrar"]')); else await ND.sleep(450);
  }
  async function protocolsView(scope) {
    if (S.group !== 'obrigacoes') { await click(q('[data-nav="side-obrigacoes"]')); await ND.sleep(450); }
    if (S.screen !== 'protocolos') { await click(q('[data-tab="protocolos"]')); await ND.sleep(450); }
    const want = { cliente: scope.client ? clientName(scope.client) : 'Todos', obl: scope.obl || 'Todas' };
    const cur = S.pf;
    const chg = want.cliente !== cur.cliente || want.obl !== cur.obl;
    if (want.cliente !== cur.cliente) await pickOption('p-cliente', want.cliente);
    if (want.obl !== cur.obl) await pickOption('p-obrig', want.obl);
    if (chg) await click(q('[data-id="btn-filtrar"]')); else await ND.sleep(450);
  }
  async function editTask(a) {
    const row = q(`.tr[data-id="${a.taskId}"]`);
    await click(row.querySelector('[data-act="edit-task"]')); await ND.sleep(550);
    await focus('[data-id="edit-form"]', 1.3);
    if (a.resp) await pickOption('f-e-resp', a.resp);
    if (a.prazo) await type('f-e-prazo', a.prazo);
    await ND.sleep(250);
    await click(q('[data-id="btn-salvar-edit"]')); await ND.sleep(650);
  }

  /* Ponto de entrada usado pelo motor de cenários. */
  N.act = async (s) => {
    if (s.skipIf && N.matches(s.skipIf)) return;
    switch (s.nibo) {
      case 'click': return click(q(s.sel));
      case 'pick': return pickOption(s.field, s.option);
      case 'type': return type(s.field, s.text);
      case 'focus': return focus(s.sel, s.z || 1.25);
      case 'focusReset': return focusReset();
      case 'highlight': return highlight(s.sel);
      case 'wait': return ND.sleep(s.ms || 400);
      case 'tasksView': return tasksView(s.scope || {});
      case 'protocolsView': return protocolsView(s.scope || {});
      case 'editTask': return editTask(s);
    }
  };

  /* ---------- navegação ---------- */
  function go(screen) {
    S.screen = screen;
    S.group = screen === 'tarefas' ? 'tarefas' : 'obrigacoes';
    closeMenu();
    renderSide(); renderTop(); renderScreen();
  }

  function renderSide() {
    const g = S.group;
    const si = (icon, label, o = {}) =>
      `<a class="si ${o.on ? 'on' : ''}" ${o.nav ? `data-nav="${o.nav}"` : ''} ${o.act ? `data-act="${o.act}"` : ''}>${I(icon, 17)}<span>${label}</span>${o.badge ? `<b class="bdg">${o.badge}</b>` : ''}${o.isnew ? '<em class="new">NOVO</em>' : ''}${o.chev ? `<span class="chv">${I(o.open ? 'chev-up' : 'chev-down', 13)}</span>` : ''}</a>`;
