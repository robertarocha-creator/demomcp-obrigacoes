  <script>
/* Autocomplete do composer. NÃO é um chat livre: a digitação serve para encontrar
   experiências da biblioteca (ND.lib). Tudo local, JavaScript puro.

   Matching: texto normalizado (minúsculas, sem acento, sem pontuação) contra
   prompt, short, keywords, empresa, categoria e módulos. Todos os termos digitados
   precisam casar. Ranking (do mais forte ao mais fraco):
     frase exata no prompt > início de palavra no prompt/short > keyword >
     empresa > categoria/módulo > correspondência parcial. Máximo de 4 sugestões. */
(function () {
  const ND = window.NiboDemo;
  const AC = (ND.ac = {});
  const MAX = 4;
  const STOP = new Set(['de', 'da', 'do', 'das', 'dos', 'a', 'o', 'e', 'as', 'os', 'para', 'que', 'um', 'uma', 'no', 'na', 'em']);

  const norm = (s) => String(s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9\s]/g, ' ').replace(/\s+/g, ' ').trim();
  const words = (s) => s.split(' ').filter(Boolean);

  function entry(sc) {
    const prompt = norm(sc.prompt), short = norm(sc.short);
    const company = sc.company ? norm(ND.q.cname(sc.company)) : '';
    return {
      sc, prompt, pw: words(prompt), sw: words(short),
      kw: (sc.keywords || []).map(norm), cw: words(company),
      kind: norm(sc.kind), mods: (sc.modules || []).map(norm)
    };
  }

  function tokenScore(e, t) {
    let s = 0;
    if (e.pw.includes(t)) s = Math.max(s, 40);
    else if (e.pw.some((w) => w.startsWith(t))) s = Math.max(s, 34);
    if (e.sw.some((w) => w.startsWith(t))) s = Math.max(s, 30);
    if (e.kw.includes(t)) s = Math.max(s, 28);
    else if (e.kw.some((k) => words(k).some((w) => w.startsWith(t)))) s = Math.max(s, 22);
    if (e.cw.some((w) => w.startsWith(t))) s = Math.max(s, 18);
    if (e.kind.startsWith(t) || e.mods.some((m) => m.startsWith(t))) s = Math.max(s, 10);
    if (s === 0 && t.length >= 3 && e.prompt.includes(t)) s = 5;
    return s;
  }

  AC.search = (query) => {
    const q = norm(query);
    if (q.length < 2) return [];
    const tokens = words(q).filter((t) => !STOP.has(t));
    if (!tokens.length) return [];
    const out = [];
    ND.lib.searchable().forEach((sc, order) => {
      const e = entry(sc);
      let total = 0;
      for (const t of tokens) { const s = tokenScore(e, t); if (!s) return; total += s; }
      if (e.prompt.includes(q)) total += 60;
      if ((' ' + e.prompt).includes(' ' + q)) total += 20;
      out.push({ sc, score: total, order });
    });
    return out.sort((a, b) => b.score - a.score || a.order - b.order).slice(0, MAX);
  };

  /* ---------- interface ---------- */
  let root, field, panel, results = [], active = -1;

  const isOpen = () => !!panel && !panel.hidden;
  AC.close = () => {
    if (!panel) return;
    panel.hidden = true; panel.innerHTML = ''; results = []; active = -1;
    field.setAttribute('aria-expanded', 'false'); field.removeAttribute('aria-activedescendant');
  };

  function item(sc, i) {
    return `<button type="button" class="ac-item" role="option" id="ac-o${i}" data-ac="${i}" aria-selected="${i === active}"><i class="kind k-${sc.id}">${sc.kind}</i><span class="q">${ND.q.esc(sc.prompt)}</span></button>`;
  }
  function render(query) {
    results = AC.search(query);
    active = -1;
    if (!results.length) {
      const sug = ND.lib.featured().slice(0, 3);
      results = sug.map((sc) => ({ sc, score: 0 }));
      panel.innerHTML = `<div class="ac-msg">Não encontrei esse exemplo nesta demonstração.</div><div class="ac-sub">Experimente uma destas perguntas:</div>${sug.map(item).join('')}`;
    } else {
      panel.innerHTML = results.map((r, i) => item(r.sc, i)).join('');
    }
    panel.hidden = false;
    field.setAttribute('aria-expanded', 'true');
  }
  function setActive(i) {
    if (!results.length) return;
    active = (i + results.length) % results.length;
    panel.querySelectorAll('.ac-item').forEach((el, k) => el.setAttribute('aria-selected', String(k === active)));
    field.setAttribute('aria-activedescendant', 'ac-o' + active);
  }
  function choose(i) {
    const r = results[i]; if (!r) return;
    AC.close(); field.value = ''; root.classList.remove('has-text');
    ND.chat.userTyped = true;
    ND.engine.run(r.sc.id);
  }

  /* Enter executa o item ativo; sem item ativo, só executa se houver um resultado claramente melhor */
  function enter() {
    if (!isOpen() || !results.length) return;
    if (active >= 0) return choose(active);
    const clear = results[0].score > 0 && (results.length === 1 || results[0].score >= 1.5 * results[1].score);
    if (clear) choose(0); else setActive(0);
  }

  AC.attach = (chatRoot, f) => {
    root = chatRoot; field = f; panel = root.querySelector('#ac');
    field.addEventListener('input', () => {
      ND.chat.userTyped = true;
      root.classList.toggle('has-text', !!field.value.trim());
      if (field.value.trim().length < 2) AC.close(); else render(field.value);
    });
    field.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && isOpen()) { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp' && isOpen()) { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); enter(); }
      else if (e.key === 'Escape' && isOpen()) { e.preventDefault(); e.stopPropagation(); AC.close(); }
    });
    panel.addEventListener('mousedown', (e) => e.preventDefault());
    panel.addEventListener('click', (e) => { const it = e.target.closest('.ac-item'); if (it) choose(Number(it.dataset.ac)); });
    root.querySelector('.cmp-send').addEventListener('click', () => { if (field.value.trim().length >= 2) { if (!isOpen()) render(field.value); enter(); } });
    if (!AC.docBound) { AC.docBound = true; document.addEventListener('click', (e) => { if (isOpen() && !e.target.closest('.composer-wrap')) AC.close(); }); }
  };
})();

</script>
  <script>
/* Motor da demo: lê um cenário da biblioteca (js/library.js), monta os passos com o
   contexto da conversa e executa em ordem, coordenando o chat (direita) e o Nibo (esquerda).

   Passos do chat:
     {chat:'think', sec, ms} · {chat:'tool', id, text} · {chat:'answer', html: string | () => string}
   Passos do Nibo (o cursor da IA executa):
     {nibo:'click', sel, skipIf} · {nibo:'pick', field, option} · {nibo:'type', field, text}
     {nibo:'focus', sel, z} · {nibo:'focusReset'} · {nibo:'highlight', sel} · {nibo:'wait', ms}
     {nibo:'tasksView', scope} · {nibo:'protocolsView', scope} · {nibo:'editTask', taskId, prazo, resp}
   Outros: {pill:'consultando as tarefas'} (selo sobre o Nibo) · {run: (ctx) => ...} (atualiza o contexto)
   O convite final (conclusão, "Continue a conversa", "testar outra coisa", "Como conectar")
   é acrescentado automaticamente ao fim de cada cenário. */
(function () {
  const ND = window.NiboDemo;
  const E = (ND.engine = { running: false, followUps: [] });

  async function exec(step) {
    if (step.par) return Promise.all(step.par.map(exec));
    if (step.run) { step.run(ND.ctx); return; }
    if (step.pill) { ND.ui.pill(step.pill); return; }
    if (step.chat) {
      /* o foco vai para o chat nas etapas da IA; os chips de "ferramenta" não disputam a atenção */
      if (step.chat === 'tool' && !E.toolSeen) {
        /* "Usando a integração Nibo Contador" é o gatilho: o Nibo entra em cena e só então o cursor age */
        E.toolSeen = true; ND.ui.focus('chat');
        await ND.chat.tool(step);
        await ND.ui.revealNibo();
        return;
      }
      if (step.chat === 'answer') await ND.sleep(380);   // pausa: o usuário vê o que aconteceu no Nibo antes da explicação
      if (step.chat !== 'tool' && step.chat !== 'toolDone') ND.ui.focus('chat');
      if (step.chat === 'answer' && typeof step.html === 'function') step = { ...step, html: step.html() };
      return ND.chat[step.chat](step);
    }
    if (step.nibo) { if (step.nibo !== 'wait') ND.ui.focus('nibo'); return ND.nibo.act(step); }
    if (step.wait) return ND.sleep(step.wait);
  }

  /* follow-ups válidos: o cenário de destino existe e está disponível no contexto atual */
  function resolveFollowUps(sc) {
    const raw = typeof sc.followUps === 'function' ? sc.followUps(ND.ctx) : sc.followUps || [];
    return raw.filter((f) => { const t = ND.lib.get(f.scenario); return t && (!t.available || t.available(ND.ctx)); });
  }

  E.run = async function (id, params = {}) {
    if (E.running) return;
    const sc = ND.lib.get(id);
    if (!sc) return;
    let built;
    try { built = sc.build(ND.ctx, params); } catch (err) { console.error('Cenário indisponível no contexto atual:', id, err); return; }
    E.running = true;
    const runId = ND.runId;
    E.toolSeen = false;
    ND.ctx.scenarioId = id;
    ND.chat.setBusy(true);
    ND.chat.beginRun(sc);
    ND.ui.focus('chat');
    try {
      await ND.chat.typeUser(params.label || sc.prompt);
      for (const step of built.steps) await exec(step);
      E.followUps = resolveFollowUps(sc);
      await exec({ chat: 'cta', followUps: E.followUps, scenario: sc });
      ND.ui.pill(null); ND.ui.focus('');
      ND.nibo.hideCursor();
    } catch (err) {
      if (err !== ND.CANCEL) {
        console.error('Erro na demonstração:', err);
        ND.ui.pill(null); ND.nibo.hideCursor();
      }
    } finally {
      if (runId === ND.runId) { E.running = false; ND.chat.setBusy(false); }
    }
  };

  /* "Continue a conversa": executa o follow-up escolhido, com o contexto atual */
  E.runFollow = (i) => {
    const f = E.followUps[i];
    if (f) E.run(f.scenario, { ...f.params, label: f.label });
  };
})();

</script>
