              (total ? `<p>Minha prioridade seria começar pelas tarefas atrasadas ${Q.de(g[0].key)}.</p>` : '');
          })
        ]
      };
    },
    followUps: (ctx) => [
      ...(ctx.topClientId ? [fu(`Ver as tarefas ${Q.de(ctx.topClientId)}`, 'overdue-client', { clientId: ctx.topClientId })] : []),
      fu('Mostrar só o Departamento Fiscal', 'fiscal-pending', { keepScope: true }),
      ...(ctx.topClientId ? [fu('Criar uma tarefa de cobrança', 'create-followup-task', { clientId: ctx.topClientId, taskTitle: 'Cobrar tarefas atrasadas' })] : [])
    ]
  });

  add({
    id: 'client-panorama', kind: 'Analisar', short: 'Panorama de um cliente',
    prompt: 'Me dê um panorama da Clínica Horizonte.',
    keywords: ['panorama', 'resumo', 'situação', 'situacao', 'cliente', 'clínica', 'clinica', 'horizonte', 'tudo', 'contexto'],
    company: 'hor', modules: ['tarefas', 'protocolos'], done: 'Análise concluída',
    build(ctx, p) {
      const cid = p.clientId || 'hor';
      const next = Q.protocols({ client: cid }).find((x) => Q.isNear(x)) || Q.protocols({ client: cid })[0];
      return {
        steps: [
          patch({ clientId: cid, lastScope: { client: cid }, lastModule: 'protocolos' }),
          ...intro(5, 'consultando as tarefas', 'Consultando tarefas'),
          ...tasksView({ client: cid }),
          { pill: 'consultando os protocolos' },
          { nibo: 'click', sel: '[data-nav="side-obrigacoes"]', skipIf: { group: 'obrigacoes' } },
          { nibo: 'wait', ms: 450 },
          ...protocolsView({ client: cid }, next ? `.tr[data-id="${next.id}"]` : '.tr:not(.hide)'),
          ...reset,
          answer(() => {
            const open = Q.tasks({ client: cid }); const late = open.filter(Q.isLate);
            const wait = open.filter((t) => t.status === 'Aguardando cliente');
            const items = [`<li><b>${Q.plural(open.length, 'tarefa aberta', 'tarefas abertas')}</b>, ${late.length ? `sendo ${late.length} atrasada${late.length > 1 ? 's' : ''}` : 'nenhuma atrasada'}</li>`];
            if (wait.length) items.push(`<li><b>${Q.plural(wait.length, 'tarefa aguardando', 'tarefas aguardando')} o cliente</b>: ${Q.join(wait.map((t) => Q.esc(t.title)))}</li>`);
            if (next) items.push(`<li><b>${Q.esc(Q.oblShort(next.obl))}</b> com vencimento ${Q.isNear(next) ? 'próximo' : 'em breve'} (${Q.short(next.due)}, R$ ${next.value})</li>`);
            return `<p>${Q.TheB(cid)} tem <b>${items.length} ${items.length === 1 ? 'ponto' : 'pontos'}</b> para acompanhar:</p><ul class="ans-facts">${items.join('')}</ul>` +
              `<p>Quer que eu abra as tarefas ou consulte o protocolo?</p>`;
          })
        ]
      };
    },
    followUps: (ctx) => [
      fu('Ver as tarefas', 'client-tasks', { clientId: ctx.clientId }),
      fu('Abrir o protocolo mais próximo', 'open-next-protocol', { clientId: ctx.clientId }),
      fu('Criar uma tarefa de acompanhamento', 'create-followup-task', { clientId: ctx.clientId })
    ]
  });

  add({
    id: 'clients-most-overdue', kind: 'Analisar', short: 'Clientes com mais atrasos',
    prompt: 'Quais clientes concentram mais tarefas atrasadas?',
    keywords: ['clientes', 'concentram', 'mais', 'tarefas', 'atrasadas', 'ranking', 'atraso', 'maiores', 'pendências'],
    company: null, modules: ['tarefas'], done: 'Análise concluída',
    build() {
      return {
        steps: [
          patch({ lastScope: { late: true }, lastModule: 'tarefas', clientId: null, topClientId: (overdueByClient()[0] || {}).key || null }),
          ...intro(4, 'consultando as tarefas', 'Consultando tarefas'),
          ...tasksView({ late: true }, 1.12), ...reset,
          answer(() => {
            const g = overdueByClient(); const total = g.reduce((s, x) => s + x.n, 0);
            if (!g.length) return '<p>Nenhum cliente tem tarefas atrasadas agora.</p>';
            return `<p>Clientes com mais tarefas atrasadas:</p>` +
              `<ol class="ans-list">${g.slice(0, 3).map((x) => `<li><b>${Q.esc(Q.cname(x.key))}</b><span>${Q.plural(x.n, 'tarefa atrasada', 'tarefas atrasadas')}</span></li>`).join('')}</ol>` +
              `<p>${Q.TheB(g[0].key)} concentra ${g[0].n} das ${total} tarefas atrasadas do escritório.</p>`;
          })
        ]
      };
    },
    followUps: (ctx) => [
      ...(ctx.topClientId ? [fu(`Abra as tarefas ${Q.de(ctx.topClientId)}`, 'overdue-client', { clientId: ctx.topClientId })] : []),
      fu('Mostre apenas as do Departamento Fiscal', 'fiscal-pending', { keepScope: true }),
      fu('Quem são os responsáveis por esses atrasos?', 'responsibles')
    ]
  });

  add({
    id: 'clients-delay-and-due', kind: 'Analisar', short: 'Atrasos + vencimentos',
    prompt: 'Quais clientes têm tarefas atrasadas e obrigações próximas do vencimento?',
    keywords: ['clientes', 'atraso', 'atrasadas', 'obrigações', 'obrigacoes', 'vencimento', 'próximos', 'proximos', 'risco', 'prioridade'],
    company: null, modules: ['tarefas', 'protocolos'], done: 'Análise concluída',
    build() {
      const risky = () => overdueByClient().filter((x) => Q.protocols({ client: x.key, near: true }).length);
      return {
        steps: [
          patch({ lastScope: { late: true }, lastModule: 'protocolos', clientId: null, topClientId: (risky()[0] || {}).key || null }),
          ...intro(5, 'consultando as tarefas', 'Consultando tarefas'),
          ...tasksView({ late: true }, 1.12),
          { pill: 'consultando os protocolos' },
          { nibo: 'click', sel: '[data-nav="side-obrigacoes"]', skipIf: { group: 'obrigacoes' } },
          { nibo: 'wait', ms: 450 },
          { nibo: 'click', sel: '[data-tab="protocolos"]', skipIf: { screen: 'protocolos' } },
          { nibo: 'wait', ms: 450 },
          ...protocolsView({}, '.tr[data-near="1"]', 1.12), ...reset,
          answer(() => {
            const r = risky();
            if (!r.length) return '<p>Nenhum cliente combina tarefas atrasadas com obrigações próximas do vencimento.</p>';
            return `<p><b>${Q.plural(r.length, 'cliente merece', 'clientes merecem')} atenção primeiro</b>:</p>` +
              `<ol class="ans-list">${r.map((x) => `<li><b>${Q.esc(Q.cname(x.key))}</b><span>${Q.plural(x.n, 'tarefa atrasada', 'tarefas atrasadas')} + ${Q.join([...new Set(Q.protocols({ client: x.key, near: true }).map((y) => Q.oblShort(y.obl)))])} próximo${new Set(Q.protocols({ client: x.key, near: true }).map((y) => Q.oblShort(y.obl))).size > 1 ? 's' : ''} do vencimento</span></li>`).join('')}</ol>`;
          })
        ]
      };
    },
    followUps: (ctx) => [
      ...(ctx.topClientId ? [fu('Abra o cliente mais crítico', 'client-panorama', { clientId: ctx.topClientId })] : []),
      fu('Mostre só o Departamento Fiscal', 'fiscal-pending', { keepScope: true })
    ]
  });
})();

