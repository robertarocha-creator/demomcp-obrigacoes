  function saveTask() {
    const d = S.data, id = 'n' + (++S.seq);
    const respName = val('f-d-resp'), u = D.get().users.find((x) => x.name === respName);
    const c = S.drawerClients[0] ? D.get().clients.find((x) => x.name === S.drawerClients[0]) : null;
    d.tasks.push({ id, title: txt('f-d-titulo') || 'Nova tarefa', client: c ? c.id : null, dept: val('f-d-dept') || '', status: 'A fazer', due: txt('f-d-prazo'), resp: u ? u.ini : 'AL' });
