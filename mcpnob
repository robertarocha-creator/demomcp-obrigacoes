.hd-menu { position: absolute; right: 0; top: 36px; min-width: 150px; background: #fff; border: 1px solid #E3E8EF; border-radius: 10px; padding: 6px; box-shadow: 0 8px 24px rgba(0, 45, 114, .12); z-index: 60; }
