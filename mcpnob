  /* ---------- filtros ---------- */
  function matchTask(t, f) {
    const u = D.get().users.find((x) => x.name === f.resp);
    const open = !['Concluído', 'Cancelado', 'Baixa justificada'].includes(t.status);
    return (
      (f.resp === 'Todos' || (u && u.ini === t.resp)) &&
      (f.status === 'Em aberto' ? open : t.status === f.status) &&
      (f.cliente === 'Todos' || clientName(t.client) === f.cliente) &&
      (f.dept === 'Todos' || t.dept === f.dept) &&
      (!f.fim || !t.due || D.key(t.due) <= D.key(f.fim)) &&
      (!f.ini || !t.due || D.key(t.due) >= D.key(f.ini)) &&
      (!f.q || (t.title + ' ' + clientName(t.client)).toLowerCase().includes(f.q.toLowerCase()))
    );
  }
  function matchProto(p, f) {
    return (
      (f.cliente === 'Todos' || clientName(p.client) === f.cliente) &&
      (f.obl === 'Todas' || p.obl === f.obl) &&
      (!f.fim || D.key(p.due) <= D.key(f.fim)) && (!f.ini || D.key(p.due) >= D.key(f.ini)) &&
      (!f.q || (p.obl + ' ' + clientName(p.client)).toLowerCase().includes(f.q.toLowerCase()))
    );
  }
  const val = (id) => { const f = fld(id); return f ? (f.dataset.value != null ? f.dataset.value : f.querySelector('.v').textContent.trim()) : ''; };
  const txt = (id) => { const f = fld(id); return f ? f.querySelector('.v').textContent.trim() : ''; };

  function applyRows(list, match, f) {
    let n = 0;
    canvas.querySelectorAll('.tbody .tr').forEach((r) => {
      const item = list.find((x) => x.id === r.dataset.id);
      const ok = item && match(item, f);
      r.classList.toggle('hide', !ok); r.classList.remove('hl'); if (ok) n++;
    });
    const c = fld('cnt'); if (c) c.textContent = n;
  }

  /* ---------- listas suspensas ---------- */
  function optionsFor(id) {
    const d = D.get(), names = d.users.map((u) => u.name), cl = d.clients.map((c) => c.name);
