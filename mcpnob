.cmp-field::placeholder { color: #9a9a9a; opacity: 1; }
.composer:focus-within { box-shadow: 0 0 0 2px rgba(0, 114, 206, .16); }
.has-text .cmp-send { opacity: 1; }
.cmp-send[role="button"] { cursor: pointer; }
.ac { position: absolute; left: 0; right: 0; bottom: calc(100% + 8px); background: #fff; border: 1px solid #E3E8EF; border-radius: 12px; box-shadow: 0 10px 28px rgba(0, 45, 114, .13); padding: 6px; display: flex; flex-direction: column; gap: 2px; z-index: 20; animation: pop .15s; }
