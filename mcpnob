          { nibo: 'wait', ms: 450 },
          ...protocolsView({}, '.tr[data-near="1"]', 1.12),
          ...reset,
          answer(() => {
            const g = overdueByClient(); const total = g.reduce((s, x) => s + x.n, 0);
            const tomorrow = Q.tasks({ dueOn: Q.tomorrow() });
            const near = nearProtocols();
            const lines = [];
            if (total) lines.push(`<p>🔴 <b>${Q.plural(total, 'tarefa está atrasada', 'tarefas estão atrasadas')}</b> no escritório. ${Q.TheB(g[0].key)} concentra ${g[0].n} ${g[0].n === 1 ? 'dela' : 'delas'}.</p>`);
            if (tomorrow.length) lines.push(`<p>🟡 <b>${Q.plural(tomorrow.length, 'tarefa vence', 'tarefas vencem')} amanhã</b>: ${Q.esc(tomorrow[0].title)}, ${Q.de(tomorrow[0].client)}${tomorrow.length > 1 ? ` e mais ${tomorrow.length - 1}` : ''}.</p>`);
            if (near.length) {
              const types = [...new Set(near.map((x) => Q.oblShort(x.obl)))];
