/* ---------- palco: dois estados ----------
   chat-only : só a IA, centralizada (Nibo montado, mas sem ocupar espaço)
   workspace : Nibo 60% + IA 40%
   A transição anima as colunas do grid (fr), o espaçamento e a opacidade; o chat
   desliza para a direita enquanto o Nibo entra pela esquerda. Sem display:none. */
.stage { --dur: .62s; --ease: cubic-bezier(.4, 0, .2, 1); flex: 1; min-height: 0; display: grid; grid-template-columns: 0fr 1fr; column-gap: 0; padding: 0 12px 12px; transition: grid-template-columns var(--dur) var(--ease), column-gap var(--dur) var(--ease); }
.stage[data-mode="workspace"] { grid-template-columns: 3fr 2fr; column-gap: 10px; }
.pane { position: relative; min-height: 0; min-width: 0; background: #fff; border: 1px solid #E3E8EF; border-radius: 10px; overflow: hidden; transition: border-color .4s ease, box-shadow .4s ease, opacity .4s ease; }
.pane-chat { justify-self: center; width: 100%; max-width: 780px; }
.pane-nibo { opacity: 0; visibility: hidden; pointer-events: none; transition: opacity calc(var(--dur) * .8) var(--ease) calc(var(--dur) * .15), visibility 0s linear var(--dur), border-color .4s ease, box-shadow .4s ease; }
.stage[data-mode="workspace"] .pane-nibo { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity calc(var(--dur) * .8) var(--ease) calc(var(--dur) * .15), visibility 0s, border-color .4s ease, box-shadow .4s ease; }
