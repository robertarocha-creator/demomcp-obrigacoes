/* Claude: editorial, creme e terracota */
.chat[data-p="claude"] { --ur: 10px; --cr: 16px; --kbg: #f1ebdd; --kfg: #8a5a3c; --intfg: #9a8470; --intac: #c6613f; --inticon: sepia(.9) saturate(.8) opacity(.7); --chipline: #e6e1d3; --chip: #fffefb; }
.chat[data-p="claude"] .chip-p { border-radius: 10px; }
.chat[data-p="claude"] .chip-p:hover { border-color: #d9a48f; }
.chat[data-p="claude"] .chip-p .q { font-family: var(--afont); font-size: 14px; }
.chat[data-p="claude"] .think { color: #9a8470; }
.chat[data-p="claude"] .done { color: #8a6a2f; }
