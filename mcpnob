.chat[data-p="claude"] .ans-card, .chat[data-p="claude"] .ans-file { border-radius: 10px; }

/* Gemini: leve, azul Google, superfícies azuladas, formas bem arredondadas */
.chat[data-p="gemini"] { --kbg: #e8f0fe; --kfg: #1a56c6; --intfg: #5f6368; --intac: #1a73e8; --inticon: grayscale(.2) opacity(.8); --user: #e9eef6; --chip: #f4f7fc; --chipline: #e3eaf5; --cbg: #f0f4f9; }
