.ac-sub { padding: 0 10px 6px; font: 400 12px/1.4 var(--font); color: var(--muted); }
.follow .chip-p.mini { border-radius: 999px; padding: 5px 12px; }

/* ---------- espaçamento por estado ---------- */
.chat-scroll, .dock, .chat-top { transition: padding var(--dur, .62s) var(--ease, ease); }
.chat-welcome { transition: opacity .4s ease, transform .4s ease, gap var(--dur, .62s) var(--ease, ease); }
.stage[data-mode="chat-only"] .chat-top { padding: 0 24px; }
