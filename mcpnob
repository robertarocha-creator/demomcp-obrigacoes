  let modalProv = null;

  /* ---- selo sobre o Nibo: "Claude está consultando as tarefas" ---- */
  ui.pill = (text) => {
    const el = $('#aiPill');
    if (!text) { el.classList.remove('on'); return; }
    const p = ND.providers[current];
    el.innerHTML = `<img src="${p.logo}" alt=""><span><b>${p.name}</b> está ${text}</span><i class="spin"></i>`;
    el.classList.add('on');
  };

  /* ---- dois estados: 'chat-only' (só a IA) e 'workspace' (Nibo 60% + IA 40%) ---- */
  const DUR = 0.62; // segundos; respeita o controle de velocidade
  ui.mode = () => $('.stage').dataset.mode;
  ui.setMode = (mode) => {
    const st = $('.stage'), nb = $('.pane-nibo');
    st.style.setProperty('--dur', (DUR / ND.speed) + 's');
    st.dataset.mode = mode;
    if (mode === 'chat-only') { nb.setAttribute('inert', ''); nb.setAttribute('aria-hidden', 'true'); }
    else { nb.removeAttribute('inert'); nb.removeAttribute('aria-hidden'); }
  };
  /* o Nibo desliza para dentro; depois de ~250ms o cursor da IA começa a agir */
  ui.revealNibo = async () => {
    if (ui.mode() === 'workspace') return;
    ui.setMode('workspace');
    await ND.sleep(DUR * 1000 + 30);
    await ND.sleep(250);
  };
  /* largura final do Nibo (60%), para ele não "reescalar" durante a transição */
  ui.measure = () => {
    const st = $('.stage'), w = st.clientWidth - 24;
    st.style.setProperty('--nbw', Math.max(0, Math.round((w - 10) * 0.6 - 2)) + 'px');
  };

  /* ---- foco sutil entre os painéis ---- */
  ui.focus = (which) => { $('.stage').dataset.focus = which || ''; };

  /* ---- escolha do provedor (o popover fica no topo do chat) ---- */
  ui.select = (id) => {
    ND.cancelAll();
    ND.engine.running = false;
    current = id;
    const p = ND.providers[id];
    document.documentElement.style.setProperty('--ia', p.accent);
    document.body.dataset.p = id;
    ND.chat.mount($('#chatPane'), id);
    ND.resetCtx();
    ui.setMode('chat-only');
    ND.nibo.reset();
    ND.nibo.setProvider(p);
    ui.pill(null); ui.focus('');
    try { const u = new URL(location.href); u.searchParams.set('ia', id); history.replaceState(null, '', u); } catch (e) { /* file:// */ }
  };

  /* ---- modal Como conectar ---- */
  function openConnect(id) {
    modalProv = id || current;
    renderConnect();
    $('#connect').hidden = false;
    document.body.classList.add('modal-open');
    $('#connect .cx-close').focus();
  }
  function closeConnect() { $('#connect').hidden = true; document.body.classList.remove('modal-open'); }
  function renderConnect() {
    const p = ND.providers[modalProv];
    $('#cxTabs').innerHTML = ND.providerOrder.map((id) => {
      const q = ND.providers[id];
      return `<button type="button" class="cx-tab" data-cx="${id}" aria-pressed="${id === modalProv}"><img src="${q.logo}" alt=""><span>${q.name}</span></button>`;
    }).join('');
    $('#cxBody').style.setProperty('--cx', p.accent);
    $('#cxBody').innerHTML = `
      <h2>Como conectar o Nibo no ${p.name}</h2>
      <p class="cx-sub">Converse com os dados do seu escritório direto na IA.</p>
      <div class="cx-url"><div><small>Endereço do conector (MCP)</small><code>${ND.MCP_URL}</code></div><button type="button" class="cx-copy" data-copy>${ND.icon('copy', 15)}<span>Copiar</span></button></div>
      <ol class="cx-steps">${p.guide.steps.map((s) => `<li>${s}</li>`).join('')}</ol>
      <p class="cx-plan">${p.guide.plan}</p>`;
  }

  function closePopovers() {
    document.querySelectorAll('.pm-list').forEach((l) => { l.hidden = true; });
    document.querySelectorAll('.ptop-btn').forEach((b) => b.setAttribute('aria-expanded', 'false'));
    $('#hdMenu').hidden = true; $('#btnMore').setAttribute('aria-expanded', 'false');
  }
  function markSpeed() {
    document.querySelectorAll('.hd-opt').forEach((o) => o.setAttribute('aria-checked', String(Number(o.dataset.speed) === ND.speed)));
  }

  document.addEventListener('click', (e) => {
    const t = e.target;
    if (!t.closest('.pm') && !t.closest('.hd-wrap')) closePopovers();

    const pb = t.closest('.ptop-btn');
    if (pb) {
      const list = pb.parentElement.querySelector('.pm-list'); const open = list.hidden;
      closePopovers(); list.hidden = !open; pb.setAttribute('aria-expanded', String(open)); return;
    }
    const pm = t.closest('.pm-item'); if (pm) { const id = pm.dataset.pick; closePopovers(); if (id !== current) ui.select(id); return; }

    if (t.closest('#btnMore')) {
      const open = $('#hdMenu').hidden; closePopovers(); $('#hdMenu').hidden = !open; $('#btnMore').setAttribute('aria-expanded', String(open)); markSpeed(); return;
    }
    const sp = t.closest('.hd-opt'); if (sp) { ND.speed = Number(sp.dataset.speed); markSpeed(); closePopovers(); return; }

    const chip = t.closest('.chip-p');
    if (chip) { if (chip.dataset.fu != null) return ND.engine.runFollow(Number(chip.dataset.fu)); return ND.engine.run(chip.dataset.sc); }
    const cn = t.closest('[data-connect]'); if (cn) return openConnect(cn.dataset.connect);
    const tab = t.closest('[data-cx]'); if (tab) { modalProv = tab.dataset.cx; return renderConnect(); }
    if (t.closest('[data-copy]')) {
      const btn = t.closest('[data-copy]');
      const done = () => { btn.classList.add('ok'); btn.querySelector('span').textContent = 'Copiado'; setTimeout(() => { btn.classList.remove('ok'); btn.querySelector('span').textContent = 'Copiar'; }, 1800); };
      if (navigator.clipboard) navigator.clipboard.writeText(ND.MCP_URL).then(done, done); else done();
      return;
    }
    if (t.closest('.cx-close') || t.classList.contains('cx-back')) return closeConnect();
    if (t.closest('#btnReset')) return ui.select(current);
    if (t.closest('#btnFull')) {
      if (document.fullscreenElement) document.exitFullscreen();
      else if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (!$('#connect').hidden) closeConnect(); else closePopovers();
  });

  /* ---- início ---- */
  window.addEventListener('DOMContentLoaded', () => {
    markSpeed();
    ui.measure();
    if ('ResizeObserver' in window) new ResizeObserver(ui.measure).observe($('.stage'));
    ND.nibo.init($('#nbView'), $('#nbCanvas'));
    const qp = new URLSearchParams(location.search).get('ia');
    ui.select(ND.providers[qp] ? qp : 'chatgpt');
  });
})();

</script>
  <script>
    /* ícones dos botões do topo */
    (function () {
      var I = window.NiboDemo.icon;
      document.getElementById('btnReset').innerHTML = I('refresh', 16);
      document.getElementById('btnFull').innerHTML = I('maximize', 16);
      document.getElementById('btnMore').innerHTML = I('dots-h', 16);
    })();
  </script>
</body>
</html>
